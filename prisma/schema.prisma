generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       BigInt
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Platform {
  id           BigInt      @id @default(autoincrement())
  name         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now())
  platformId   String?     @unique
  activeUsers  User[]
  userRoles    UserRole[]
}

model User {
  id               BigInt     @id @default(autoincrement())
  name             String?
  email            String?    @unique
  emailVerified    DateTime?
  image            String?
  activePlatformId BigInt
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now())
  accounts         Account[]
  DocFile          DocFile[]
  sessions         Session[]
  activePlatform   Platform   @relation(fields: [activePlatformId], references: [id])
  userRoles        UserRole[]
}

model UserRole {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  platformId BigInt
  role       String
  createdAt  DateTime @default(now())
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DocFile {
  id         BigInt     @id @default(autoincrement())
  platformId BigInt
  uploaderId BigInt
  filename   String?
  storagekey String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now())
  uuid       String?    @unique
  uploader   User       @relation(fields: [uploaderId], references: [id])
  docImage   DocImage[]
}

model DocImage {
  id         BigInt   @id @default(autoincrement())
  docFileId  BigInt
  page       Int
  thumbnail  Boolean  @default(false)
  storagekey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  docFile    DocFile  @relation(fields: [docFileId], references: [id])
}
