generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       BigInt
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            BigInt     @id @default(autoincrement())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  accounts      Account[]
  sessions      Session[]
  UserRoles     UserRole[]
}

model UserRole {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  platformId BigInt
  role       String
  createdAt  DateTime @default(now())
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Platform {
  id        BigInt     @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  userRoles UserRole[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EBl {
  id           String    @id @db.VarChar(48)
  blNumber     String    @db.VarChar(160)
  status       EBlStatus @default(DRAFT)
  blType       String?   @db.VarChar(32)
  pol          String?   @db.VarChar(16)
  pod          String?   @db.VarChar(16)
  shipper      String?   @db.VarChar(160)
  consignee    String?   @db.VarChar(160)
  releaseAgent String?   @db.VarChar(160)
  eta          DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([updatedAt(sort: Desc)], map: "idx_updated_at")
}

enum EBlStatus {
  DRAFT
  PROCESSING
  COMPLETED
  PRINTED
}
