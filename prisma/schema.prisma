generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       BigInt
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Platform {
  id          BigInt     @id @default(autoincrement())
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now())
  activeUsers User[]
  userRoles   UserRole[]
}

model User {
  id               BigInt     @id @default(autoincrement())
  name             String?
  email            String?    @unique
  emailVerified    DateTime?
  image            String?
  activePlatformId BigInt
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now())
  accounts         Account[]
  DocFile          DocFile[]
  sessions         Session[]
  activePlatform   Platform   @relation(fields: [activePlatformId], references: [id])
  userRoles        UserRole[]
}

model UserRole {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt
  platformId BigInt
  role       String
  createdAt  DateTime @default(now())
  platform   Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EBl {
  id           String    @id @db.VarChar(48)
  blNumber     String    @db.VarChar(160)
  status       EBlStatus @default(DRAFT)
  blType       String?   @db.VarChar(32)
  pol          String?   @db.VarChar(16)
  pod          String?   @db.VarChar(16)
  shipper      String?   @db.VarChar(160)
  consignee    String?   @db.VarChar(160)
  releaseAgent String?   @db.VarChar(160)
  eta          DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())
  docFileId    BigInt?

  @@index([updatedAt(sort: Desc)], map: "idx_ebl_updated_at")
}

model DocFile {
  id         BigInt   @id @default(autoincrement())
  platformId BigInt
  uploaderId BigInt
  filename   String?
  storagekey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  uploader   User     @relation(fields: [uploaderId], references: [id])
}

model DocImage {
  id         BigInt   @id @default(autoincrement())
  docFileId  BigInt
  page       Int
  thumbnail  Boolean  @default(false)
  storagekey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model DocAiTask {
  id         BigInt          @id @default(autoincrement())
  externalId String          @db.VarChar(160)
  docFileId  BigInt
  status     DocAiTaskStatus @default(UPLOADED)
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now())

  @@index([status], map: "idx_doc_ai_task_status")
}

model EblJourney {
  id               BigInt           @id @default(autoincrement())
  eBlId            BigInt
  action           EblJourneyAction
  lastStatus       EBlStatus
  targetPlatformId BigInt?
  sourcePlatformId BigInt?
  userId           BigInt?
  createdAt        DateTime         @default(now())

  @@index([eBlId], map: "idx_ebl_journey_ebl_id")
  @@index([targetPlatformId, eBlId], map: "idx_ebl_journey_target_platform_id_ebl_id")
}

enum EBlStatus {
  DRAFT
  PROCESSING
  COMPLETED
  PRINTED
}

enum DocAiTaskStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum EblJourneyAction {
  ISSUE
  GRANT_SHIPPER
  GRANT_CONSIGNEE
  GRANT_RELEASE_AGENT
  ENDORSE
  AMEND
  SURRENDER
}
